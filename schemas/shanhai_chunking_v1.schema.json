        },
        "max_codepoints": {
          "type": "integer",
          "minimum": 1
        },
        "context_codepoints": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_policy": {
          "const": "furthest_verified_cue_within_hard_budget_else_exact_cap"
        },
        "oversized_policy": {
          "const": "split_exact_codepoints_no_exception"
        },
        "combining_policy": {
          "const": "may_split_grapheme_preserve_all_codepoints"
        },
        "primary_overlap": {
          "const": 0
        }
