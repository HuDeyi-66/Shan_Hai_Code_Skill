        "generated_layout": {
          "type": "array",
          "items": {}
        },
        "information_loss": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "schema",
        "method",
        "artifact_sha256",
        "representation_sha256",
        "mapping_sha256",
        "qualification_receipt_sha256",
        "exclusions",
        "generated_layout",
        "information_loss"
      ],
      "additionalProperties": false
    },
