      "required": [
        "coordinate_system",
        "retained_codepoints",
        "retained_bytes",
        "primary_codepoints",
        "primary_partition",
        "primary_exclusions",
        "primary_overlap",
        "secondary_in_primary_denominator",
        "chunker_generated_layout",
        "chunker_information_loss"
      ],
      "additionalProperties": false
