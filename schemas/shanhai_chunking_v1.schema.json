            "primary",
            "secondary_context"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 0
        },
        "byte_start": {
          "type": "integer",
          "minimum": 0
        },
        "byte_end": {
          "type": "integer",
          "minimum": 0
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chunk_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference_target_status": {
          "const": "not_assessed"
        }
      },
      "required": [
        "schema",
        "binding",
        "artifact_id",
        "artifact_sha256",
        "source_id",
        "derivation_record_sha256",
        "role",
        "order",
        "char_start",
        "char_end",
        "byte_start",
        "byte_end",
        "text_sha256",
        "chunk_id",
        "reference_target_status"
      ],
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "properties": {
        "chunk_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "primary",
            "secondary_context"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
