        },
        "verification": {
          "enum": [
            "independently_verified",
            "candidate"
          ]
        },
        "evidence_id": {
          "type": "string"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "representation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "position",
        "kind",
        "verification",
        "evidence_id",
        "evidence_sha256",
        "representation_sha256"
