{
  "type": "object",
  "properties": {
    "schema": {
      "const": "shanhai-source-chunking/1.0.0"
    },
    "status": {
      "enum": [
        "CHUNKED",
        "EMPTY_INPUT"
      ]
    },
    "representation": {
      "$ref": "#/$defs/representation"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "language_mode": {
      "const": "declared"
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      }
    },
    "primary_chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "secondary_chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "status",
    "representation",
    "binding",
    "language_mode",
    "config",
    "cues",
    "primary_chunks",
    "secondary_chunks",
    "coverage",
    "uncertainty",
    "result_sha256"
  ],
  "additionalProperties": false,
