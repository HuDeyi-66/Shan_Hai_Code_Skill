        }
      },
      "required": [
        "schema",
        "source_id",
        "artifact_id",
        "artifact_sha256",
        "source_uri",
        "source_qualification_id",
        "representation_sha256",
        "representation_byte_length",
        "coordinate_system",
        "derivation"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "shanhai-chunk-config/1.0.0"
        },
        "unit": {
