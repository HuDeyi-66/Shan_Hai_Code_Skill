          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "representation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "language": {
          "enum": [
            "zh",
            "en",
            "ja",
            "ru",
            "fr",
            "ar",
            "de",
            "es",
            "pt"
          ]
        },
        "profile_id": {
          "type": "string"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cue_records_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
